{
  "name": "fastwebtools-status",
  "main": "status-entry.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "build": {"command": "node prepare-viewer.mjs && node build-151.mjs"},
  "services": [{"binding": "ADMIN", "service": "fastwebtools-admin"}],
  "d1_databases": [{"binding": "STATUS_DB", "database_name": "fastwebtools-status-db", "database_id": "e0040028-f577-4dce-ad2e-b600daf5f265"}],
  "triggers": {"crons": ["*/5 * * * *"]},
  "routes": [
    {"pattern": "www.fastwebtools.online/status", "zone_id": "86c05b33141d4056aa0884e467877bf5"},
    {"pattern": "www.fastwebtools.online/status/*", "zone_id": "86c05b33141d4056aa0884e467877bf5"}
  ]
}
